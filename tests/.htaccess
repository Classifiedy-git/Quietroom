# The test suite is for local/CI use only. Nothing here may be requested
# over HTTP. These scripts create accounts and would run against the live
# database.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
Options -Indexes
